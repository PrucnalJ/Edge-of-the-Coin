---
/**
 * A struck coin, generated rather than drawn by hand.
 *
 * The face is layered guilloché — the engine-turned lattice used as security
 * printing on banknotes, share certificates and passports. The bands alternate
 * between the two position metals, so the coin carries both sides at equal
 * weight. The reeded seam down the centre (CSS, in .coin::before) is the edge
 * you are meant to stand on.
 */
interface Props { size?: number; }
const { size = 340 } = Astro.props;
---
<div class="coin" id="coin" aria-hidden="true">
  <canvas id="coin-canvas" width={size * 2} height={size * 2}></canvas>
</div>

<script is:inline define:vars={{ size }}>
  (function () {
    var cv = document.getElementById('coin-canvas');
    var host = document.getElementById('coin');
    if (!cv || !cv.getContext) return;
    var ctx = cv.getContext('2d');
    var S = size * 2;
    var cx = S / 2, cy = S / 2;

    var css = getComputedStyle(document.documentElement);
    var tok = function (n, fb) { return (css.getPropertyValue(n) || fb).trim(); };

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /**
     * A guilloché band: N circles with their centres spaced around a ring.
     * Where the circles overlap they cut the lens-shaped lattice that engine
     * turning produces on banknotes and coin fields. Squashing each circle
     * slightly along its own radius is what keeps the lattice from reading as
     * a plain row of rings.
     */
    function band(ringR, circR, n, squash) {
      for (var i = 0; i < n; i++) {
        var a = (i / n) * Math.PI * 2;
        var ox = cx + Math.cos(a) * ringR;
        var oy = cy + Math.sin(a) * ringR;
        ctx.beginPath();
        ctx.ellipse(ox, oy, circR, circR * squash, a, 0, Math.PI * 2);
        ctx.stroke();
      }
    }

    function draw() {
      ctx.clearRect(0, 0, S, S);

      // ground
      ctx.fillStyle = tok('--surface', '#F7F9F7');
      ctx.beginPath();
      ctx.arc(cx, cy, S / 2 - 2, 0, Math.PI * 2);
      ctx.fill();

      var Rad = S / 2 - 2;
      ctx.lineWidth = 1.15;

      /* Concentric bands, alternating the two position metals so the coin carries
         both sides at equal weight. */
      var layers = [
        { c: tok('--pos-1', '#8A6A2F'), ring: 0.70, circ: 0.26, n: 54, sq: 0.72, alpha: 0.58 },
        { c: tok('--ink', '#141817'),   ring: 0.58, circ: 0.20, n: 42, sq: 0.66, alpha: 0.20 },
        { c: tok('--pos-2', '#2F6B63'), ring: 0.46, circ: 0.19, n: 36, sq: 0.70, alpha: 0.58 },
        { c: tok('--pos-1', '#8A6A2F'), ring: 0.27, circ: 0.13, n: 26, sq: 0.68, alpha: 0.44 },
      ];
      layers.forEach(function (L) {
        ctx.strokeStyle = L.c;
        ctx.globalAlpha = L.alpha;
        band(Rad * L.ring, Rad * L.circ, L.n, L.sq);
      });

      // concentric hairlines, the way a coin's field is finished
      ctx.globalAlpha = 0.55;
      ctx.strokeStyle = tok('--rule', '#B9C1BD');
      [0.985, 0.955].forEach(function (f) {
        ctx.beginPath();
        ctx.arc(cx, cy, Rad * f, 0, Math.PI * 2);
        ctx.stroke();
      });

      // the central device
      ctx.globalAlpha = 0.9;
      ctx.fillStyle = tok('--ink', '#141817');
      ctx.beginPath();
      ctx.arc(cx, cy, Rad * 0.035, 0, Math.PI * 2);
      ctx.fill();

      ctx.globalAlpha = 1;
    }

    draw();

    // Redraw when the theme flips, so the coin is struck in the right metals.
    var mq = window.matchMedia('(prefers-color-scheme: dark)');
    if (mq.addEventListener) mq.addEventListener('change', function () { setTimeout(draw, 40); });

    // It turns slowly once it has settled. Never when reduced motion is asked for.
    if (!reduce && host) {
      setTimeout(function () { host.classList.add('turning'); }, 1200);
    }
  })();
</script>
