---
/**
 * A struck coin, spinning on its edge.
 *
 * Drawn as an actual cylinder rather than a flat disc: the two faces are
 * pre-rendered guilloché — the engine-turned lattice used as security printing
 * on banknotes and share certificates — and the milled rim between them is
 * computed each frame, so as the coin turns the reeding compresses toward the
 * silhouette the way it does on a real coin spinning on a table.
 *
 * The obverse is struck in the first position metal and the reverse in the
 * second, so the coin carries both sides. Twice per turn it presents nothing
 * but its edge, which is the whole point of the place.
 */
interface Props { size?: number; }
const { size = 340 } = Astro.props;
---
<div class="coin" id="coin">
  <canvas id="coin-canvas" width={size * 2} height={size * 2} role="img"
    aria-label="A coin turning slowly on its edge, one face struck in bronze and the other in patina."></canvas>
</div>

<script is:inline define:vars={{ size }}>
  (function () {
    var cv = document.getElementById('coin-canvas');
    if (!cv || !cv.getContext) return;
    var ctx = cv.getContext('2d');

    var S = size * 2;
    var cx = S / 2, cy = S / 2;
    var R = S * 0.43;          // face radius
    var T = R * 0.15;          // thickness

    var css = getComputedStyle(document.documentElement);
    function tok(n, fb) { return (css.getPropertyValue(n) || fb).trim(); }

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---------------------------------------------------------------------
       Faces are drawn once into offscreen canvases. Re-stroking several hundred
       guilloché ellipses every frame would be wasteful; scaling a bitmap is not.
       --------------------------------------------------------------------- */
    function makeFace(primary, secondary) {
      var f = document.createElement('canvas');
      f.width = f.height = S;
      var g = f.getContext('2d');
      var fx = S / 2, fy = S / 2;

      g.beginPath();
      g.arc(fx, fy, R, 0, Math.PI * 2);
      g.fillStyle = tok('--surface', '#F7F9F7');
      g.fill();

      g.lineWidth = 1.15;

      // Bands of overlapping ellipses: where they cross they cut the lens
      // lattice that engine turning produces.
      var bands = [
        { c: primary,                 ring: 0.70, circ: 0.26, n: 54, sq: 0.72, a: 0.58 },
        { c: tok('--ink', '#141817'), ring: 0.58, circ: 0.20, n: 42, sq: 0.66, a: 0.18 },
        { c: secondary,               ring: 0.46, circ: 0.19, n: 36, sq: 0.70, a: 0.46 },
        { c: primary,                 ring: 0.27, circ: 0.13, n: 26, sq: 0.68, a: 0.44 },
      ];
      bands.forEach(function (B) {
        g.strokeStyle = B.c;
        g.globalAlpha = B.a;
        for (var i = 0; i < B.n; i++) {
          var ang = (i / B.n) * Math.PI * 2;
          var ox = fx + Math.cos(ang) * R * B.ring;
          var oy = fy + Math.sin(ang) * R * B.ring;
          g.beginPath();
          g.ellipse(ox, oy, R * B.circ, R * B.circ * B.sq, ang, 0, Math.PI * 2);
          g.stroke();
        }
      });

      // the field is finished with concentric hairlines
      g.globalAlpha = 0.55;
      g.strokeStyle = tok('--rule', '#B9C1BD');
      [0.985, 0.95].forEach(function (k) {
        g.beginPath();
        g.arc(fx, fy, R * k, 0, Math.PI * 2);
        g.stroke();
      });

      // central device
      g.globalAlpha = 0.9;
      g.fillStyle = tok('--ink', '#141817');
      g.beginPath();
      g.arc(fx, fy, R * 0.035, 0, Math.PI * 2);
      g.fill();
      g.globalAlpha = 1;

      return f;
    }

    var faceA, faceB;
    function buildFaces() {
      faceA = makeFace(tok('--pos-1', '#8A6A2F'), tok('--pos-2', '#2F6B63'));
      faceB = makeFace(tok('--pos-2', '#2F6B63'), tok('--pos-1', '#8A6A2F'));
    }
    buildFaces();

    /* ---------------------------------------------------------------------
       One frame. Orthographic projection of a cylinder turning about its
       vertical axis: a local point (x, y, z) lands at screen x of
       x·cos0 + z·sin0, so each face centre sits +/-(T/2)·sin0 off the axis and
       the face is foreshortened to |cos0|.
       --------------------------------------------------------------------- */
    function frame(theta) {
      ctx.clearRect(0, 0, S, S);

      var cosT = Math.cos(theta), sinT = Math.sin(theta);
      var xA = cx + (T / 2) * sinT;     // obverse centre
      var xB = cx - (T / 2) * sinT;     // reverse centre
      var semi = R * Math.abs(cosT);
      var left = Math.min(xA, xB), right = Math.max(xA, xB);

      // --- the rim: the silhouette spanning the two face ellipses ----------
      ctx.beginPath();
      ctx.moveTo(left, cy - R);
      ctx.lineTo(right, cy - R);
      ctx.ellipse(right, cy, semi, R, 0, -Math.PI / 2, Math.PI / 2, false);
      ctx.lineTo(left, cy + R);
      ctx.ellipse(left, cy, semi, R, 0, Math.PI / 2, -Math.PI / 2, false);
      ctx.closePath();

      var grad = ctx.createLinearGradient(left - semi, 0, right + semi, 0);
      grad.addColorStop(0.0, tok('--surface-sunk', '#DCE1DE'));
      grad.addColorStop(0.5, tok('--surface', '#F7F9F7'));
      grad.addColorStop(1.0, tok('--surface-sunk', '#DCE1DE'));
      ctx.fillStyle = grad;
      ctx.fill();

      ctx.save();
      ctx.clip();

      // --- milling: grooves run parallel to the coin's axis ----------------
      // A groove sits at angle phi around the disc, and is on the near side
      // only when its outward normal has turned toward the viewer.
      ctx.strokeStyle = tok('--ink', '#141817');
      ctx.globalAlpha = 0.3;
      ctx.lineWidth = 1.1;
      var steps = 190;
      for (var i = 0; i < steps; i++) {
        var phi = (i / steps) * Math.PI * 2;
        if (-Math.cos(phi) * sinT <= 0) continue;          // far side of the rim
        var y = cy + R * Math.sin(phi);
        var xc = cx + R * Math.cos(phi) * cosT;
        ctx.beginPath();
        ctx.moveTo(xc - (T / 2) * sinT, y);
        ctx.lineTo(xc + (T / 2) * sinT, y);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      ctx.restore();

      // rim outline
      ctx.strokeStyle = tok('--rule', '#B9C1BD');
      ctx.lineWidth = 1.2;
      ctx.stroke();

      // --- whichever face is turned toward the viewer ----------------------
      if (semi > 0.6) {
        var face = cosT > 0 ? faceA : faceB;
        var xV = cosT > 0 ? xA : xB;
        ctx.save();
        ctx.translate(xV, cy);
        ctx.scale(Math.abs(cosT), 1);
        ctx.drawImage(face, -S / 2, -S / 2);
        ctx.restore();

        ctx.beginPath();
        ctx.ellipse(xV, cy, semi, R, 0, 0, Math.PI * 2);
        ctx.strokeStyle = tok('--rule', '#B9C1BD');
        ctx.lineWidth = 1.1;
        ctx.stroke();
      }
    }

    /* ---------------------------------------------------------------------
       Motion: comes in fast and eases down to a slow steady turn, the way a
       coin set spinning on a table does.
       --------------------------------------------------------------------- */
    var REST = 0.30;   // radians/sec once settled - a full turn in about 21s

    if (reduce) {
      // Held still, a little off square, so the rim and one face both read.
      frame(-0.42);
    } else {
      var theta = -0.55;
      var last = null;
      var spin = 7.2;
      var boost = 0;
      var running = false;

      var tick = function (now) {
        if (!running) return;
        if (last === null) last = now;
        var dt = Math.min((now - last) / 1000, 0.05);
        last = now;

        spin += (REST - spin) * Math.min(dt * 1.35, 1);
        theta += (spin + boost) * dt;
        boost *= Math.pow(0.12, dt);

        frame(theta);
        requestAnimationFrame(tick);
      };

      function start() {
        if (running) return;
        running = true;
        last = null;              // do not integrate the time spent paused
        requestAnimationFrame(tick);
      }
      function stop() { running = false; }

      var host = document.getElementById('coin');

      // Don't burn a frame loop on a coin nobody can see.
      if (host && 'IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          entries[0].isIntersecting ? start() : stop();
        }, { threshold: 0 }).observe(host);
      } else {
        start();
      }

      if (host) {
        host.addEventListener('click', function () { boost += 9; start(); });
        host.addEventListener('mouseenter', function () { boost += 2.6; start(); });
      }
    }

    // Re-strike in the right metals when the theme changes.
    var mq = window.matchMedia('(prefers-color-scheme: dark)');
    if (mq.addEventListener) {
      mq.addEventListener('change', function () {
        setTimeout(function () {
          css = getComputedStyle(document.documentElement);
          buildFaces();
          if (reduce) frame(-0.42);
        }, 40);
      });
    }
  })();
</script>
