---
/**
 * A struck coin, turning on its edge.
 *
 * Drawn as a real cylinder rather than a flat disc: two engraved faces and a
 * milled rim computed each frame, so the reeding compresses into the silhouette
 * the way it does on a coin spinning on a table.
 *
 * The faces are struck like a medal — raised bead border, arc inscriptions, and
 * a device in relief — rather than printed. Relief is what makes metal read as
 * metal, so every engraved element is drawn three times: a dark pass offset
 * down-right, a light pass offset up-left, then the mid tone on top.
 *
 * The metals are deliberately NOT theme tokens. A coin is an object, not page
 * chrome; bronze stays bronze whatever the page behind it is doing.
 */
interface Props { size?: number; }
const { size = 340 } = Astro.props;
---
<div class="coin" id="coin" title="Click to spin">
  <canvas id="coin-canvas" width={size * 2} height={size * 2} role="img"
    aria-label="A coin turning on its edge. One face is struck in bronze with a balance and the motto Audi Alteram Partem; the other in nickel with a coin standing on its edge."></canvas>
</div>

<script is:inline define:vars={{ size }}>
  (function () {
    var cv = document.getElementById('coin-canvas');
    var host = document.getElementById('coin');
    if (!cv || !cv.getContext) return;
    var ctx = cv.getContext('2d');

    var S = size * 2;
    var cx = S / 2, cy = S / 2;
    var R = S * 0.43;
    var T = R * 0.16;

    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    // hi / lo are the relief highlight and shadow; mid is the raised surface
    // itself; f1 and f2 light the field from upper left to lower right.
    var BRONZE = { hi: '#EBD8A9', mid: '#8E6B2C', lo: '#4A3413', f1: '#CBA968', f2: '#7B5C28' };
    var NICKEL = { hi: '#F4F7F5', mid: '#8F9A96', lo: '#4C5451', f1: '#DCE2DF', f2: '#8A9591' };

    /* ------------------------------------------------------------------ */
    /* face rendering                                                      */
    /* ------------------------------------------------------------------ */

    function arcText(g, fx, fy, str, r, opts) {
      g.save();
      g.translate(fx, fy);
      g.font = opts.font;
      g.textAlign = 'center';
      g.textBaseline = 'middle';

      var chars = str.split('');
      var sp = opts.spacing || 0;
      var widths = chars.map(function (c) { return g.measureText(c).width + sp; });
      var total = widths.reduce(function (a, b) { return a + b; }, 0);
      var dir = opts.flip ? -1 : 1;
      var a = opts.at - dir * (total / r) / 2;

      for (var i = 0; i < chars.length; i++) {
        var wAng = widths[i] / r;
        g.save();
        g.rotate(a + dir * wAng / 2);
        g.translate(0, -r);
        if (opts.flip) g.rotate(Math.PI);
        // relief: shadow below, highlight above, raised surface on top
        g.fillStyle = opts.m.lo;  g.fillText(chars[i], 1.6, 1.6);
        g.fillStyle = opts.m.hi;  g.fillText(chars[i], -1.4, -1.4);
        g.fillStyle = opts.m.mid; g.fillText(chars[i], 0, 0);
        g.restore();
        a += dir * wAng;
      }
      g.restore();
    }

    /** Draw a path three times to raise it off the field. */
    function relief(g, draw, m, depth) {
      g.save(); g.translate(depth, depth);  draw(g, m.lo);  g.restore();
      g.save(); g.translate(-depth, -depth); draw(g, m.hi); g.restore();
      draw(g, m.mid);
    }

    /** Obverse device: a balance. The reader does the weighing on this site. */
    function balance(g, fx, fy, k) {
      return function (gg, colour) {
        gg.strokeStyle = colour;
        gg.fillStyle = colour;
        gg.lineWidth = k * 0.055;
        gg.lineCap = 'round';
        gg.lineJoin = 'round';

        gg.beginPath();                        // beam
        gg.moveTo(fx - k, fy - k * 0.42);
        gg.lineTo(fx + k, fy - k * 0.42);
        gg.stroke();

        gg.beginPath();                        // column
        gg.moveTo(fx, fy - k * 0.42);
        gg.lineTo(fx, fy + k * 0.62);
        gg.stroke();

        gg.beginPath();                        // foot
        gg.moveTo(fx - k * 0.46, fy + k * 0.62);
        gg.lineTo(fx + k * 0.46, fy + k * 0.62);
        gg.stroke();

        [-1, 1].forEach(function (s) {         // hangers and pans
          gg.beginPath();
          gg.moveTo(fx + s * k, fy - k * 0.42);
          gg.lineTo(fx + s * k, fy - k * 0.02);
          gg.stroke();
          gg.beginPath();
          gg.moveTo(fx + s * k - k * 0.34, fy - k * 0.02);
          gg.lineTo(fx + s * k + k * 0.34, fy - k * 0.02);
          gg.lineTo(fx + s * k + k * 0.2, fy + k * 0.24);
          gg.lineTo(fx + s * k - k * 0.2, fy + k * 0.24);
          gg.closePath();
          gg.stroke();
        });
      };
    }

    /** Reverse device: a coin standing on its edge. */
    function onEdge(g, fx, fy, k) {
      return function (gg, colour) {
        gg.strokeStyle = colour;
        gg.lineWidth = k * 0.055;
        gg.lineCap = 'round';

        gg.beginPath();                        // the coin, seen edge-on
        gg.ellipse(fx, fy - k * 0.06, k * 0.2, k * 0.78, 0, 0, Math.PI * 2);
        gg.stroke();

        for (var i = -6; i <= 6; i++) {        // its reeding
          var t = i / 7;
          var y = fy - k * 0.06 + t * k * 0.7;
          var w = k * 0.2 * Math.sqrt(Math.max(0, 1 - t * t)) * 0.85;
          gg.beginPath();
          gg.moveTo(fx - w, y);
          gg.lineTo(fx + w, y);
          gg.stroke();
        }

        gg.beginPath();                        // the table it stands on
        gg.moveTo(fx - k * 0.82, fy + k * 0.78);
        gg.lineTo(fx + k * 0.82, fy + k * 0.78);
        gg.stroke();
      };
    }

    function makeFace(m, top, bottom, device) {
      var f = document.createElement('canvas');
      f.width = f.height = S;
      var g = f.getContext('2d');
      var fx = S / 2, fy = S / 2;

      // --- field, lit from the upper left --------------------------------
      var field = g.createLinearGradient(fx - R, fy - R, fx + R, fy + R);
      field.addColorStop(0, m.f1);
      field.addColorStop(1, m.f2);
      g.beginPath();
      g.arc(fx, fy, R, 0, Math.PI * 2);
      g.fillStyle = field;
      g.fill();

      // --- raised rim ----------------------------------------------------
      g.lineWidth = R * 0.055;
      g.strokeStyle = m.lo;
      g.beginPath(); g.arc(fx, fy, R * 0.965, 0, Math.PI * 2); g.stroke();
      g.strokeStyle = m.hi;
      g.lineWidth = R * 0.03;
      g.beginPath(); g.arc(fx, fy, R * 0.955, Math.PI * 0.9, Math.PI * 1.75); g.stroke();
      g.strokeStyle = m.lo;
      g.beginPath(); g.arc(fx, fy, R * 0.955, Math.PI * -0.1, Math.PI * 0.75); g.stroke();

      // --- bead border, the giveaway that something is a struck coin -----
      var beads = 108;
      for (var i = 0; i < beads; i++) {
        var a = (i / beads) * Math.PI * 2;
        var bx = fx + Math.cos(a) * R * 0.885;
        var by = fy + Math.sin(a) * R * 0.885;
        var rr = R * 0.019;
        g.beginPath(); g.arc(bx + 1.2, by + 1.2, rr, 0, Math.PI * 2);
        g.fillStyle = m.lo; g.fill();
        g.beginPath(); g.arc(bx - 0.9, by - 0.9, rr, 0, Math.PI * 2);
        g.fillStyle = m.hi; g.fill();
        g.beginPath(); g.arc(bx, by, rr * 0.86, 0, Math.PI * 2);
        g.fillStyle = m.mid; g.fill();
      }

      // --- inscriptions ---------------------------------------------------
      var font = 'Bodoni Moda, Didot, Georgia, serif';
      arcText(g, fx, fy, top, R * 0.755, {
        at: 0, flip: false, spacing: R * 0.03, m: m,
        font: '500 ' + Math.round(R * 0.105) + 'px ' + font,
      });
      arcText(g, fx, fy, bottom, R * 0.755, {
        at: Math.PI, flip: true, spacing: R * 0.028, m: m,
        font: '500 ' + Math.round(R * 0.08) + 'px ' + font,
      });

      // --- device in relief ------------------------------------------------
      relief(g, device(g, fx, fy - R * 0.02, R * 0.3), m, R * 0.012);

      // --- two small stops separating the inscriptions ---------------------
      [-1, 1].forEach(function (s) {
        g.beginPath();
        g.arc(fx + s * R * 0.755, fy, R * 0.022, 0, Math.PI * 2);
        g.fillStyle = m.lo; g.fill();
      });

      return f;
    }

    var faceA, faceB;
    function buildFaces() {
      faceA = makeFace(BRONZE, 'EDGE OF THE COIN', 'AUDI ALTERAM PARTEM', balance);
      faceB = makeFace(NICKEL, 'BOTH SIDES EVERY TIME', 'ONE IN SIX THOUSAND', onEdge);
    }
    buildFaces();

    // Canvas takes a snapshot of the font situation at draw time, so re-strike
    // once the display face has actually arrived.
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(function () {
        buildFaces();
        if (!spinning) frame(still);
      });
    }

    /* ------------------------------------------------------------------ */
    /* the cylinder                                                        */
    /* ------------------------------------------------------------------ */

    function frame(theta) {
      ctx.clearRect(0, 0, S, S);

      var cosT = Math.cos(theta), sinT = Math.sin(theta);
      var xA = cx + (T / 2) * sinT;
      var xB = cx - (T / 2) * sinT;
      var semi = R * Math.abs(cosT);
      var left = Math.min(xA, xB), right = Math.max(xA, xB);
      var edgeMetal = cosT > 0 ? BRONZE : NICKEL;

      // rim silhouette spanning the two face ellipses
      ctx.beginPath();
      ctx.moveTo(left, cy - R);
      ctx.lineTo(right, cy - R);
      ctx.ellipse(right, cy, semi, R, 0, -Math.PI / 2, Math.PI / 2, false);
      ctx.lineTo(left, cy + R);
      ctx.ellipse(left, cy, semi, R, 0, Math.PI / 2, -Math.PI / 2, false);
      ctx.closePath();

      var grad = ctx.createLinearGradient(left - semi, 0, right + semi, 0);
      grad.addColorStop(0.00, edgeMetal.f2);
      grad.addColorStop(0.42, edgeMetal.f1);
      grad.addColorStop(1.00, edgeMetal.f2);
      ctx.fillStyle = grad;
      ctx.fill();

      ctx.save();
      ctx.clip();
      // Milling: a groove at angle phi shows only once its outward normal has
      // turned toward the viewer.
      ctx.strokeStyle = edgeMetal.lo;
      ctx.globalAlpha = 0.55;
      ctx.lineWidth = 1.3;
      var steps = 190;
      for (var i = 0; i < steps; i++) {
        var phi = (i / steps) * Math.PI * 2;
        if (-Math.cos(phi) * sinT <= 0) continue;
        var y = cy + R * Math.sin(phi);
        var xc = cx + R * Math.cos(phi) * cosT;
        ctx.beginPath();
        ctx.moveTo(xc - (T / 2) * sinT, y);
        ctx.lineTo(xc + (T / 2) * sinT, y);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
      ctx.restore();

      ctx.strokeStyle = edgeMetal.lo;
      ctx.lineWidth = 1.4;
      ctx.stroke();

      // the face turned toward the viewer
      if (semi > 0.6) {
        var face = cosT > 0 ? faceA : faceB;
        var xV = cosT > 0 ? xA : xB;
        ctx.save();
        ctx.translate(xV, cy);
        ctx.scale(Math.abs(cosT), 1);
        ctx.drawImage(face, -S / 2, -S / 2);
        ctx.restore();
      }
    }

    /* ------------------------------------------------------------------ */
    /* motion                                                              */
    /* ------------------------------------------------------------------ */

    var REST = 0.30;             // rad/sec once settled: a turn in ~21s
    var still = -0.42;           // a resting angle where rim and face both read
    var theta = -0.55;
    var spin = 7.2;
    var boost = 0;
    var last = null;
    var spinning = false;
    var visible = true;

    function tick(now) {
      if (!spinning) return;
      if (last === null) last = now;
      var dt = Math.min((now - last) / 1000, 0.05);
      last = now;

      spin += (REST - spin) * Math.min(dt * 1.35, 1);
      theta += (spin + boost) * dt;
      boost *= Math.pow(0.12, dt);

      frame(theta);

      // With reduced motion we honour the request and coast to a stop rather
      // than turning forever, but a deliberate tap is still allowed to spin it.
      if (reduce.matches && spin + boost < 0.45) { spinning = false; return; }
      requestAnimationFrame(tick);
    }

    function start() {
      if (spinning || !visible) return;
      spinning = true;
      last = null;
      requestAnimationFrame(tick);
    }
    function stop() { spinning = false; }

    if (reduce.matches) {
      frame(still);
    } else {
      frame(theta);
      start();
    }

    // Don't run a frame loop for a coin nobody can see.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (e) {
        visible = e[0].isIntersecting;
        if (!visible) stop();
        else if (!reduce.matches) start();
      }, { threshold: 0 }).observe(host);
    }

    // A nudge sets it going again. `click` covers touch as well as mouse.
    host.addEventListener('click', function () {
      spin = Math.max(spin, 1.2); boost += 9; start();
    });
    host.addEventListener('mouseenter', function () {
      if (reduce.matches) return;
      boost += 2.6; start();
    });

    // If the visitor turns reduced motion on or off mid-visit, respect it.
    if (reduce.addEventListener) {
      reduce.addEventListener('change', function () {
        if (reduce.matches) { stop(); frame(still); }
        else start();
      });
    }
  })();
</script>
