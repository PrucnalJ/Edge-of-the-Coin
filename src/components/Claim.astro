---
interface Props {
  claim: {
    type: 'empirical' | 'values' | 'predictive';
    text: string;
    source?: string;
    caveat?: string;
  };
  posIndex: number;
  facet: 'case' | 'cost';
  index: number;
}
const { claim, posIndex, facet, index } = Astro.props;
const id = `${posIndex}-${facet}-${index}`;
---
<li data-claim={id} data-pos={posIndex} data-facet={facet} data-type={claim.type}>
  <span class={`tag ${claim.type}`}>{claim.type}</span>{claim.text}
  {(claim.source || claim.caveat) && (
    <span class="src">
      {claim.source}
      {claim.caveat && <><br /><b>Caveat:</b> {claim.caveat}</>}
    </span>
  )}
  <button class="weigh" type="button" data-weigh={id} aria-pressed="false">
    <span class="pip"></span><span class="lbl">Weigh this</span>
  </button>
</li>
