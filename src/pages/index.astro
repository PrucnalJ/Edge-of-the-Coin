---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Coin from '../components/Coin.astro';
import { site } from '../data/site';
import { url } from '../lib/url';

const topics = (await getCollection('topics')).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);
const politics = topics.filter((t) => t.data.domain === 'politics');
const religion = topics.filter((t) => t.data.domain === 'religion');

const groups = [
  { label: 'Politics', items: politics },
  { label: 'Religion', items: religion },
].filter((g) => g.items.length > 0);
---
<Base title={site.name}>
  <div class="hero">
    <div class="hero-copy">
      <p class="eyebrow">Both sides. Every time.</p>
      <h1>Stay on the <span class="rim">edge</span> of the coin.</h1>
      <p class="lede">{site.tagline}</p>
      <p class="epigraph">{site.epigraph}</p>
    </div>
    <Coin size={340} />
  </div>

  <section>
    <div class="sec-mark">
      <p class="eyebrow">The format</p>
      <span class="bar"></span>
    </div>
    <h2 class="col">Four things worth reading, not two</h2>
    <div class="stack col">
      <p>
        Every position gets a <b>case</b>, written as its strongest advocate would write it,
        and a <b>cost</b>, conceded by that position's own serious thinkers. The second one is
        the part nobody publishes, and it is the reason this site exists.
      </p>
      <p>
        Every claim is labelled <b>empirical</b>, <b>values</b>, or <b>predictive</b>, because
        most of these arguments are two people disputing incompatible values while both pretend
        to be disputing facts. And every topic names its <b>crux</b> — the one question that,
        if it were settled, would actually move people.
      </p>
      <p><a href={url('/method/')}>Read the house rules &rarr;</a></p>
    </div>
  </section>

  {groups.map((g) => (
    <section>
      <div class="sec-mark">
        <p class="eyebrow">{g.label}</p>
        <span class="bar"></span>
      </div>
      <div class="topics">
        {g.items.map((t) => (
          <a class="topic-row" href={url(`/topics/${t.id}/`)}>
            <span class="t">{t.data.title}</span>
            <span class="meta">{t.data.status} &middot; {t.data.positions.length} positions</span>
            <span class="q">{t.data.question}</span>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section>
    <div class="col note">
      <p class="eyebrow">Status</p>
      <p>
        This site is in draft. Topics marked <b>draft</b> have not had their sourcing verified
        line by line and are not finished work. Nothing here is published in the sense that
        matters yet.
      </p>
    </div>
  </section>
</Base>
